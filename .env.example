# ==================== Supabase ====================
# (anon key هو مفتاح عام مخصص للمتصفح — ليس سراً)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ==================== الخادم (أسرار — لا تُنشر أبداً) ====================
# رمز بوت تليجرام (من @BotFather) — يُستخدم لإرسال رمز 2FA للوحة المطوّر
# وإشعارات طلبات الاشتراك. يُحفظ هنا فقط ولا يُمرَّر للمتصفح.
TELEGRAM_BOT_TOKEN=
# معرّف دردشة المطوّر (يتلقى رموز 2FA والإشعارات)
TELEGRAM_ADMIN_CHAT_ID=
# دردشة احتياطية ثانية (اختياري)
TELEGRAM_BACKUP_CHAT_ID=
# سر توقيع جلسة 2FA للوحة المطوّر (أنشئه بـ: openssl rand -hex 32)
ADMIN_2FA_SECRET=
# مفتاح service_role لعمليات خادمية محمية: إنشاء/تعديل حساب العميل وتسجيل الزوار.
# سر خادمي فقط — لا تستخدم معه NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# سر HMAC ثابت لتجزئة معرّف Cookie الزائر (أنشئه بـ: openssl rand -hex 32).
# اختياري تقنياً، لكن يُنصح به حتى لا ترتبط التجزئة بدوران مفتاح service_role.
VISITOR_HASH_SECRET=
